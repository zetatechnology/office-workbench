{
  "name": "office-workbench-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/webview",
    "packages/extension"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p packages/core && tsc -p packages/webview && tsc -p packages/extension",
    "lint": "eslint .",
    "test": "vitest run",
    "fixtures": "powershell -ExecutionPolicy Bypass -File scripts/make-fixtures.ps1",
    "edited-samples": "node scripts/make-edited-samples.mjs",
    "check-office": "powershell -ExecutionPolicy Bypass -File scripts/check-office.ps1",
    "preview": "node scripts/dev-preview.mjs",
    "package": "node scripts/build.mjs --production && cd packages/extension && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
